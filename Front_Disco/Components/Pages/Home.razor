
@page "/"

<PageTitle>Discoteca X</PageTitle>

<div class="home-page">

    <!-- BARRA DE NAVEGACIÓN -->
    <header class="navbar-custom">
        <a href="/" target="_top" class="brand">
            <span class="brand-icon">X</span>
            <span>DISCOTECA <strong>X</strong></span>
        </a>

        <nav class="nav-actions">
            <a href="/Consultar" target="_top" class="nav-link-custom">
                Consultar
            </a>

            <a href="/Login" target="_top" class="login-button">
                <span>Iniciar sesión</span>
                <span class="login-arrow">→</span>
            </a>
        </nav>
    </header>

    <!-- CONTENIDO PRINCIPAL -->
    <main class="main-content">

        <section class="hero-section">

            <div class="hero-text">

                <div class="status-label">
                    <span class="status-dot"></span>
                    SISTEMA DE GESTIÓN
                </div>

                <h1>
                    DISCOTECA
                    <span class="highlight">X.</span>
                </h1>

                <h2>
                    Control total de tu negocio.
                </h2>

                <p class="description">
                    Administra y consulta la información de tu discoteca
                    desde una plataforma centralizada. Gestiona tu inventario
                    y mantén el control de tus operaciones de manera sencilla.
                </p>

                <div class="hero-buttons">
                    <a href="/Consultar" target="_top" class="primary-button">
                        Consultar información
                        <span>→</span>
                    </a>

                    <a href="/Login" target="_top" class="secondary-button">
                        Iniciar sesión
                    </a>
                </div>

                <div class="hero-footer">
                    <span class="footer-line"></span>
                    <span>GESTIÓN · CONTROL · ORGANIZACIÓN</span>
                </div>

            </div>

            <!-- ELEMENTO VISUAL DECORATIVO -->
            <div class="hero-visual">

                <div class="visual-glow"></div>

                <div class="visual-circle circle-one"></div>
                <div class="visual-circle circle-two"></div>

                <div class="dashboard-card">

                    <div class="dashboard-header">
                        <div>
                            <span class="dashboard-caption">PLATAFORMA</span>
                            <h3>Discoteca X</h3>
                        </div>

                        <div class="dashboard-indicator"></div>
                    </div>

                    <div class="dashboard-divider"></div>

                    <div class="dashboard-content">
                        <div class="dashboard-symbol">X</div>

                        <h4>Gestión inteligente</h4>

                        <p>
                            Toda la información de tu negocio,
                            en un solo lugar.
                        </p>
                    </div>

                    <div class="dashboard-bottom">
                        <span>CONTROL DE INVENTARIO</span>
                        <span class="dashboard-line"></span>
                    </div>

                </div>

                <div class="floating-label">
                    <span class="floating-dot"></span>
                    Sistema centralizado
                </div>

            </div>

        </section>

        <!-- TARJETAS INFORMATIVAS -->
        <section class="features-section">

            <div class="feature-card">
                <div class="feature-icon">01</div>
                <div>
                    <h3>Inventario</h3>
                    <p>Organiza y controla los productos de tu negocio.</p>
                </div>
            </div>

            <div class="feature-card">
                <div class="feature-icon">02</div>
                <div>
                    <h3>Consultas</h3>
                    <p>Accede fácilmente a la información registrada.</p>
                </div>
            </div>

            <div class="feature-card">
                <div class="feature-icon">03</div>
                <div>
                    <h3>Administración</h3>
                    <p>Centraliza la gestión de tu establecimiento.</p>
                </div>
            </div>

        </section>

    </main>

    <!-- PIE DE PÁGINA -->
    <footer class="page-footer">
        <span>© 2026 Discoteca X</span>
        <span>SISTEMA DE GESTIÓN E INVENTARIO</span>
    </footer>

</div>

<style>

    /* CONFIGURACIÓN GENERAL */

    .home-page {
        min-height: 100vh;
        background:
            radial-gradient(ellipse at 80% 35%, rgba(143, 94, 35, 0.13), transparent 35%),
            #0b0b0e;
        color: #f5f1e8;
        padding: 0 7%;
        font-family: 'Segoe UI', sans-serif;
        overflow: hidden;
        position: relative;
    }

    /* NAVEGACIÓN */

    .navbar-custom {
        min-height: 95px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid rgba(255, 255, 255, 0.09);
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 13px;
        text-decoration: none;
        color: #fff;
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 3px;
    }

    .brand strong {
        color: #d8ad62;
    }

    .brand-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #bd9149;
        color: #d8ad62;
        font-size: 23px;
        font-weight: bold;
        transform: rotate(45deg);
    }

    .nav-actions {
        display: flex;
        align-items: center;
        gap: 35px;
    }

    .nav-link-custom {
        color: #c8c5bd;
        text-decoration: none;
        font-size: 14px;
        transition: color 0.3s;
    }

    .nav-link-custom:hover {
        color: #d8ad62;
    }

    .login-button {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 12px 20px;
        border: 1px solid rgba(216, 173, 98, 0.6);
        color: #d8ad62;
        text-decoration: none;
        font-size: 13px;
        transition: all 0.3s;
    }

    .login-button:hover {
        background: #d8ad62;
        color: #111;
    }

    .login-arrow {
        font-size: 18px;
    }

    /* SECCIÓN PRINCIPAL */

    .main-content {
        max-width: 1250px;
        margin: 0 auto;
    }

    .hero-section {
        min-height: 570px;
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        align-items: center;
        gap: 45px;
        padding: 65px 0;
    }

    .status-label {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: #d8ad62;
        font-size: 11px;
        letter-spacing: 3px;
        margin-bottom: 25px;
    }

    .status-dot,
    .floating-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #d8ad62;
        box-shadow: 0 0 12px #d8ad62;
    }

    .hero-text h1 {
        font-size: clamp(48px, 7vw, 86px);
        font-weight: 800;
        letter-spacing: -3px;
        line-height: 1;
        margin-bottom: 22px;
    }

    .highlight {
        color: #d8ad62;
    }

    .hero-text h2 {
        font-size: clamp(19px, 2.5vw, 26px);
        font-weight: 400;
        color: #d7d2c8;
        margin-bottom: 20px;
    }

    .description {
        max-width: 510px;
        color: #96949a;
        font-size: 15px;
        line-height: 1.9;
        margin-bottom: 35px;
    }

    /* BOTONES PRINCIPALES */

    .hero-buttons {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 15px;
    }

    .primary-button {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 30px;
        padding: 16px 23px;
        background: #d8ad62;
        color: #111;
        font-weight: 700;
        font-size: 13px;
        text-decoration: none;
        transition: all 0.3s;
    }

    .primary-button:hover {
        background: #edc982;
        transform: translateY(-3px);
        color: #111;
    }

    .primary-button span {
        font-size: 21px;
    }

    .secondary-button {
        padding: 16px 23px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #dedbd3;
        font-size: 13px;
        text-decoration: none;
        transition: all 0.3s;
    }

    .secondary-button:hover {
        border-color: #d8ad62;
        color: #d8ad62;
    }

    .hero-footer {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-top: 65px;
        color: #77747b;
        font-size: 10px;
        letter-spacing: 2px;
    }

    .footer-line {
        width: 35px;
        height: 1px;
        background: #d8ad62;
    }

    /* ELEMENTO DECORATIVO */

    .hero-visual {
        height: 420px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    .visual-glow {
        position: absolute;
        width: 320px;
        height: 320px;
        border-radius: 50%;
        background: rgba(190, 139, 64, 0.13);
        filter: blur(70px);
    }

    .visual-circle {
        position: absolute;
        border: 1px solid rgba(216, 173, 98, 0.19);
        border-radius: 50%;
    }

    .circle-one {
        width: 390px;
        height: 390px;
    }

    .circle-two {
        width: 330px;
        height: 330px;
        border-style: dashed;
        animation: rotate-circle 45s linear infinite;
    }

    .dashboard-card {
        position: relative;
        z-index: 2;
        width: 330px;
        padding: 27px;
        background: linear-gradient(145deg, #202024, #131316);
        border: 1px solid rgba(216, 173, 98, 0.3);
        box-shadow: 0 25px 80px rgba(0, 0, 0, 0.5);
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .dashboard-caption {
        color: #a19b91;
        font-size: 9px;
        letter-spacing: 2px;
    }

    .dashboard-header h3 {
        margin: 5px 0 0;
        font-size: 19px;
        font-weight: 600;
    }

    .dashboard-indicator {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: #d8ad62;
        box-shadow: 0 0 12px #d8ad62;
    }

    .dashboard-divider {
        height: 1px;
        background: rgba(255, 255, 255, 0.1);
        margin: 23px 0;
    }

    .dashboard-content {
        text-align: center;
        padding: 12px 0 25px;
    }

    .dashboard-symbol {
        width: 85px;
        height: 85px;
        margin: 0 auto 20px;
        border: 1px solid #bd9149;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #d8ad62;
        font-size: 49px;
        font-weight: 800;
        box-shadow: 0 0 35px rgba(216, 173, 98, 0.1);
    }

    .dashboard-content h4 {
        font-size: 17px;
        margin-bottom: 9px;
    }

    .dashboard-content p {
        color: #96949a;
        font-size: 12px;
        line-height: 1.7;
        margin: 0;
    }

    .dashboard-bottom {
        display: flex;
        align-items: center;
        gap: 12px;
        color: #a19b91;
        font-size: 8px;
        letter-spacing: 1.5px;
    }

    .dashboard-line {
        flex: 1;
        height: 1px;
        background: #bd9149;
    }

    .floating-label {
        position: absolute;
        z-index: 3;
        bottom: 22px;
        right: -5px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 13px 17px;
        background: #252529;
        border: 1px solid rgba(255, 255, 255, 0.09);
        color: #d5d1c8;
        font-size: 11px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    /* TARJETAS INFORMATIVAS */

    .features-section {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 17px;
        padding: 30px 0 55px;
    }

    .feature-card {
        display: flex;
        align-items: flex-start;
        gap: 18px;
        padding: 25px 20px;
        background: rgba(255, 255, 255, 0.025);
        border: 1px solid rgba(255, 255, 255, 0.08);
        transition: all 0.3s;
    }

    .feature-card:hover {
        border-color: rgba(216, 173, 98, 0.5);
        background: rgba(216, 173, 98, 0.04);
        transform: translateY(-4px);
    }

    .feature-icon {
        color: #d8ad62;
        font-size: 21px;
        font-weight: 700;
    }

    .feature-card h3 {
        font-size: 15px;
        margin-bottom: 8px;
    }

    .feature-card p {
        color: #929097;
        font-size: 12px;
        line-height: 1.6;
        margin: 0;
    }

    /* PIE DE PÁGINA */

    .page-footer {
        min-height: 65px;
        border-top: 1px solid rgba(255, 255, 255, 0.09);
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: #77747b;
        font-size: 10px;
        letter-spacing: 1.5px;
    }

    /* ANIMACIÓN */

    @@keyframes rotate-circle {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    /* DISEÑO RESPONSIVE */

    @@media (max-width: 850px) {

        .hero-section {
            grid-template-columns: 1fr;
            gap: 15px;
            padding-top: 65px;
        }

        .hero-visual {
            height: 390px;
        }

        .features-section {
            grid-template-columns: 1fr;
        }

        .hero-footer {
            margin-top: 40px;
        }
    }

    @@media (max-width: 550px) {

        .home-page {
            padding: 0 5%;
        }

        .navbar-custom {
            min-height: 80px;
        }

        .brand {
            font-size: 11px;
            letter-spacing: 1.5px;
            gap: 8px;
        }

        .brand-icon {
            width: 34px;
            height: 34px;
            font-size: 18px;
        }

        .nav-actions {
            gap: 12px;
        }

        .nav-link-custom {
            display: none;
        }

        .login-button {
            padding: 10px 12px;
            gap: 8px;
            font-size: 11px;
        }

        .hero-text h1 {
            letter-spacing: -2px;
        }

        .hero-buttons {
            align-items: stretch;
            flex-direction: column;
        }

        .primary-button,
        .secondary-button {
            width: 100%;
        }

        .hero-visual {
            transform: scale(0.85);
            margin: -20px -25px;
        }

        .dashboard-card {
            width: 300px;
        }

        .circle-one {
            width: 330px;
            height: 330px;
        }

        .circle-two {
            width: 290px;
            height: 290px;
        }

        .floating-label {
            right: 0;
        }

        .page-footer {
            gap: 15px;
            flex-wrap: wrap;
            padding: 20px 0;
            font-size: 8px;
        }
    }

</style>
