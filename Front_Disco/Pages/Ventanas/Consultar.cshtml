
@page "/Consultar"
@using Presentaciones_Discoteca.Pages
@model ProductosModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Inventario | Discoteca X</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #0b0b0e;
            color: #f5f1e8;
            font-family: 'Segoe UI', sans-serif;
            min-height: 100vh;
        }

        /* CONTENEDOR PRINCIPAL */

        .inventory-page {
            max-width: 1350px;
            margin: auto;
            padding: 35px 6%;
        }

        /* NAVEGACIÓN */

        .top-navigation {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 25px;
            border-bottom: 1px solid rgba(255,255,255,0.09);
            margin-bottom: 55px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 13px;
            color: white;
            font-size: 15px;
            font-weight: 600;
            letter-spacing: 3px;
            text-decoration: none;
        }

        .brand strong {
            color: #d8ad62;
        }

        .brand-icon {
            width: 40px;
            height: 40px;
            display: flex;
            justify-content: center;
            align-items: center;
            border: 1px solid #bd9149;
            color: #d8ad62;
            font-size: 22px;
            font-weight: bold;
        }

        .back-button {
            text-decoration: none;
            color: #d8ad62;
            border: 1px solid rgba(216,173,98,0.5);
            padding: 11px 20px;
            font-size: 13px;
            transition: 0.3s;
        }

        .back-button:hover {
            background: #d8ad62;
            color: #111;
        }

        /* ENCABEZADO */

        .section-label {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #d8ad62;
            font-size: 11px;
            letter-spacing: 3px;
            margin-bottom: 18px;
        }

        .section-dot {
            width: 7px;
            height: 7px;
            background: #d8ad62;
            border-radius: 50%;
            box-shadow: 0 0 12px #d8ad62;
        }

        .page-heading {
            margin-bottom: 35px;
        }

        .page-heading h1 {
            font-size: clamp(30px, 5vw, 45px);
            font-weight: 800;
            margin-bottom: 10px;
        }

        .page-heading h1 span {
            color: #d8ad62;
        }

        .page-heading p {
            color: #96949a;
            font-size: 14px;
            margin: 0;
        }

        /* TARJETA DEL INVENTARIO */

        .inventory-card {
            background: #151518;
            border: 1px solid rgba(216,173,98,0.23);
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            overflow: hidden;
        }

        .inventory-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 24px 28px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            flex-wrap: wrap;
            gap: 15px;
        }

        .inventory-header h2 {
            font-size: 17px;
            font-weight: 600;
            margin: 0 0 5px;
        }

        .inventory-header p {
            font-size: 12px;
            color: #96949a;
            margin: 0;
        }

        .inventory-tag {
            color: #d8ad62;
            border: 1px solid rgba(216,173,98,0.35);
            padding: 8px 14px;
            font-size: 10px;
            letter-spacing: 1.5px;
        }

        /* TABLA */

        .table-responsive {
            overflow-x: auto;
        }

        .inventory-table {
            width: 100%;
            border-collapse: collapse;
            margin: 0;
            color: #e9e5dd;
            min-width: 650px;
        }

        .inventory-table thead {
            background: #202024;
        }

        .inventory-table th {
            color: #d8ad62;
            font-size: 10px;
            letter-spacing: 1.5px;
            font-weight: 600;
            text-transform: uppercase;
            padding: 20px 25px;
            border-bottom: 1px solid rgba(216,173,98,0.25);
            white-space: nowrap;
        }

        .inventory-table td {
            padding: 20px 25px;
            font-size: 13px;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            vertical-align: middle;
        }

        .inventory-table tbody tr {
            background: #151518;
            transition: background 0.25s;
        }

        .inventory-table tbody tr:hover {
            background: #222226;
        }

        .inventory-table tbody tr:last-child td {
            border-bottom: none;
        }

        .product-code {
            color: #929097;
            font-weight: 600;
        }

        .product-name {
            color: #fff;
            font-weight: 600;
        }

        .product-presentation {
            color: #a6a2a9;
        }

        .product-price {
            color: #d8ad62;
            font-weight: 700;
        }

        /* INDICADORES DE STOCK */

        .stock-badge {
            display: inline-block;
            min-width: 45px;
            padding: 8px 13px;
            border-radius: 3px;
            font-size: 12px;
            font-weight: 700;
        }

        .stock-danger {
            color: #ff8d8d;
            background: rgba(220,53,69,0.15);
            border: 1px solid rgba(220,53,69,0.35);
        }

        .stock-warning {
            color: #eac36f;
            background: rgba(255,193,7,0.12);
            border: 1px solid rgba(255,193,7,0.3);
        }

        .stock-success {
            color: #83d6a3;
            background: rgba(25,135,84,0.15);
            border: 1px solid rgba(25,135,84,0.3);
        }

        /* ESTADO VACÍO */

        .empty-state {
            text-align: center;
            padding: 75px 20px !important;
            color: #96949a;
        }

        .empty-icon {
            font-size: 40px;
            margin-bottom: 15px;
        }

        .empty-state h3 {
            font-size: 17px;
            color: #e9e5dd;
            font-weight: 500;
        }

        .empty-state p {
            font-size: 12px;
            margin: 8px 0 0;
        }

        /* PIE DE PÁGINA */

        .page-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid rgba(255,255,255,0.09);
            margin-top: 55px;
            padding-top: 22px;
            color: #77747b;
            font-size: 10px;
            letter-spacing: 1.5px;
            gap: 15px;
            flex-wrap: wrap;
        }

        /* RESPONSIVE */

        @@media (max-width: 600px) {

            .inventory-page {
                padding: 25px 5%;
            }

            .top-navigation {
                margin-bottom: 40px;
            }

            .brand {
                font-size: 11px;
                letter-spacing: 1.5px;
            }

            .brand-icon {
                width: 33px;
                height: 33px;
            }

            .back-button {
                padding: 9px 11px;
                font-size: 11px;
            }

            .inventory-header {
                padding: 20px;
            }

            .inventory-table th,
            .inventory-table td {
                padding: 17px 15px;
            }

            .page-footer {
                font-size: 8px;
            }
        }
    </style>
</head>

<body>

    <div class="inventory-page">

        <!-- NAVEGACIÓN -->
        <header class="top-navigation">

            <a href="/" class="brand">
                <span class="brand-icon">X</span>
                <span>DISCOTECA <strong>X</strong></span>
            </a>

            <a href="/" class="back-button">
                ← Volver al inicio
            </a>

        </header>

        <!-- ENCABEZADO -->
        <section class="page-heading">

            <div class="section-label">
                <span class="section-dot"></span>
                SISTEMA DE GESTIÓN
            </div>

            <h1>
                Inventario de <span>Productos.</span>
            </h1>

            <p>
                Consulta y controla las existencias, presentaciones y precios
                de los productos registrados en tu discoteca.
            </p>

                </section>

        <!-- MENSAJE DE ERROR TEMPORAL -->
        @if (!string.IsNullOrEmpty(Model.ErrorMensaje))
        {
            <div class="alert alert-danger">
                <strong>Error al consultar los productos:</strong>
                @Model.ErrorMensaje
            </div>
        }

        <!-- TABLA DE PRODUCTOS -->
        <section class="inventory-card">
            <div class="inventory-header">

                <div>
                    <h2>Listado de productos</h2>
                    <p>Información registrada en el sistema</p>
                </div>

                <span class="inventory-tag">
                    CONTROL DE INVENTARIO
                </span>

            </div>

            <div class="table-responsive">

                <table class="inventory-table">

                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Producto</th>
                            <th>Presentación</th>
                            <th class="text-end">Precio venta</th>
                            <th class="text-center">Stock</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Lista != null && Model.Lista.Any())
                        {
                            foreach (var elemento in Model.Lista)
                            {
                                <tr>

                                    <td class="product-code">
                                        #@elemento.IdProducto
                                    </td>

                                    <td class="product-name">
                                        @elemento.NomProducto
                                    </td>

                                    <td class="product-presentation">
                                        @elemento.Presentacion
                                    </td>

                                    <td class="text-end product-price">
                                        $@elemento.PrecioVenta.ToString("N2")
                                    </td>

                                    <td class="text-center">

                                        @if (elemento.stock <= 5)
                                        {
                                            <span class="stock-badge stock-danger">
                                                @elemento.stock
                                            </span>
                                        }
                                        else if (elemento.stock <= 15)
                                        {
                                            <span class="stock-badge stock-warning">
                                                @elemento.stock
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="stock-badge stock-success">
                                                @elemento.stock
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="empty-state">

                                    <div class="empty-icon">📦</div>

                                    <h3>No hay productos registrados</h3>

                                    <p>
                                        Todavía no existen productos disponibles
                                        para mostrar en el inventario.
                                    </p>

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </section>

        <!-- PIE DE PÁGINA -->
        <footer class="page-footer">

            <span>© 2026 Discoteca X</span>

            <span>SISTEMA DE GESTIÓN E INVENTARIO</span>

        </footer>

    </div>

</body>
</html>
