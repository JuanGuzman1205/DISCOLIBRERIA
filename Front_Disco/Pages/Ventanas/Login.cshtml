@page "/Login"
@using Front_Disco.Pages
@using Presentaciones_Discoteca.Pages
@model LoginModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión | Discoteca X</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                background: radial-gradient(ellipse at 50% 25%, rgba(143, 94, 35, 0.14), transparent 45%), #0b0b0e;
                color: #f5f1e8;
                font-family: 'Segoe UI', sans-serif;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            /* CONTENEDOR PRINCIPAL */
            .login-wrapper {
                max-width: 1350px;
                width: 100%;
                margin: 0 auto;
                padding: 35px 6%;
                flex: 1;
                display: flex;
                flex-direction: column;
            }

            /* NAVEGACIÓN */
            .top-navigation {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding-bottom: 25px;
                border-bottom: 1px solid rgba(255, 255, 255, 0.09);
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 13px;
                color: white;
                font-size: 15px;
                font-weight: 600;
                letter-spacing: 3px;
                text-decoration: none;
            }

                .brand strong {
                    color: #d8ad62;
                }

            .brand-icon {
                width: 40px;
                height: 40px;
                display: flex;
                justify-content: center;
                align-items: center;
                border: 1px solid #bd9149;
                color: #d8ad62;
                font-size: 22px;
                font-weight: bold;
            }

            .back-button {
                text-decoration: none;
                color: #d8ad62;
                border: 1px solid rgba(216, 173, 98, 0.5);
                padding: 11px 20px;
                font-size: 13px;
                transition: 0.3s;
            }

                .back-button:hover {
                    background: #d8ad62;
                    color: #111;
                }

            /* SECCIÓN CENTRAL DEL LOGIN */
            .login-container {
                flex: 1;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 50px 0;
            }

            .login-card {
                width: 100%;
                max-width: 450px;
                background: #151518;
                border: 1px solid rgba(216, 173, 98, 0.25);
                box-shadow: 0 25px 70px rgba(0, 0, 0, 0.45);
                padding: 40px 35px;
            }

            .section-label {
                display: flex;
                align-items: center;
                gap: 10px;
                color: #d8ad62;
                font-size: 10px;
                letter-spacing: 3px;
                margin-bottom: 15px;
            }

            .section-dot {
                width: 7px;
                height: 7px;
                background: #d8ad62;
                border-radius: 50%;
                box-shadow: 0 0 12px #d8ad62;
            }

            .login-card h1 {
                font-size: 32px;
                font-weight: 800;
                margin-bottom: 8px;
                letter-spacing: -1px;
            }

                .login-card h1 span {
                    color: #d8ad62;
                }

            .login-subtitle {
                color: #96949a;
                font-size: 13px;
                margin-bottom: 30px;
                line-height: 1.6;
            }

            /* CAMPOS DEL FORMULARIO */
            .form-group-custom {
                margin-bottom: 22px;
            }

            .form-label-custom {
                display: block;
                color: #d8ad62;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 1.5px;
                text-transform: uppercase;
                margin-bottom: 8px;
            }

            .form-control-custom {
                width: 100%;
                background: #0e0e11;
                border: 1px solid rgba(255, 255, 255, 0.12);
                color: #f5f1e8;
                padding: 13px 16px;
                font-size: 14px;
                outline: none;
                transition: all 0.3s;
            }

                .form-control-custom::placeholder {
                    color: #5b5961;
                }

                .form-control-custom:focus {
                    border-color: #d8ad62;
                    background: #121216;
                    box-shadow: 0 0 0 3px rgba(216, 173, 98, 0.1);
                }

            /* BOTONES */
            .button-group {
                display: flex;
                flex-direction: column;
                gap: 12px;
                margin-top: 30px;
            }

            .btn-gold {
                width: 100%;
                padding: 15px 20px;
                background: #d8ad62;
                color: #111;
                border: none;
                font-weight: 700;
                font-size: 13px;
                letter-spacing: 1px;
                text-transform: uppercase;
                cursor: pointer;
                transition: all 0.3s;
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 12px;
            }

                .btn-gold:hover {
                    background: #edc982;
                    transform: translateY(-2px);
                }

            .btn-outline-custom {
                width: 100%;
                padding: 13px 20px;
                background: transparent;
                color: #a6a2a9;
                border: 1px solid rgba(255, 255, 255, 0.14);
                font-size: 12px;
                letter-spacing: 1px;
                text-transform: uppercase;
                cursor: pointer;
                transition: all 0.3s;
            }

                .btn-outline-custom:hover {
                    border-color: #d8ad62;
                    color: #d8ad62;
                }

            .btn-danger-custom {
                width: 100%;
                padding: 13px 20px;
                background: rgba(220, 53, 69, 0.15);
                color: #ff8d8d;
                border: 1px solid rgba(220, 53, 69, 0.4);
                font-size: 12px;
                font-weight: 600;
                letter-spacing: 1px;
                text-transform: uppercase;
                cursor: pointer;
                transition: all 0.3s;
            }

                .btn-danger-custom:hover {
                    background: rgba(220, 53, 69, 0.25);
                }

            /* ALERTA DE ERROR */
            .alert-custom {
                background: rgba(220, 53, 69, 0.12);
                border: 1px solid rgba(220, 53, 69, 0.35);
                color: #ff9999;
                padding: 12px 15px;
                font-size: 12px;
                margin-bottom: 22px;
            }

            /* ESTADO LOGUEADO */
            .logged-box {
                text-align: center;
                padding: 15px 0;
            }

            .logged-user {
                color: #d8ad62;
                font-weight: 700;
                font-size: 18px;
                margin: 10px 0 25px;
            }

            /* PIE DE PÁGINA */
            .page-footer {
                display: flex;
                justify-content: space-between;
                align-items: center;
                border-top: 1px solid rgba(255, 255, 255, 0.09);
                padding-top: 22px;
                color: #77747b;
                font-size: 10px;
                letter-spacing: 1.5px;
                gap: 15px;
                flex-wrap: wrap;
            }

            @@media (max-width: 600px) {
                .login-wrapper {
                    padding: 25px 5%;
                }

                .brand {
                    font-size: 11px;
                    letter-spacing: 1.5px;
                }

                .brand-icon {
                    width: 33px;
                    height: 33px;
                }

                .back-button {
                    padding: 9px 11px;
                    font-size: 11px;
                }

                .login-card {
                    padding: 30px 22px;
                }

                .page-footer {
                    font-size: 8px;
                }
            }
    </style>
</head>
<body>

    <div class="login-wrapper">

        <!-- NAVEGACIÓN -->
        <header class="top-navigation">
            <a href="/" class="brand">
                <span class="brand-icon">X</span>
                <span>DISCOTECA <strong>X</strong></span>
            </a>

            <a href="/" class="back-button">
                ← Volver al inicio
            </a>
        </header>

        <!-- CONTENIDO CENTRAL -->
        <main class="login-container">
            <div class="login-card">

                <div class="section-label">
                    <span class="section-dot"></span>
                    ACCESO AL SISTEMA
                </div>

                @if (!Model.EstaLogueado)
                {
                    <h1>Iniciar <span>Sesión.</span></h1>
                    <p class="login-subtitle">
                        Ingresa tus credenciales de empleado para administrar el inventario y operaciones.
                    </p>

                    @if (!string.IsNullOrEmpty(Model.ErrorMensaje))
                    {
                        <div class="alert-custom">
                            @Model.ErrorMensaje
                        </div>
                    }

                    <form method="post">
                        @Html.AntiForgeryToken()

                        <div class="form-group-custom">
                            <label asp-for="NombreUsuario" class="form-label-custom">Nombre de Usuario</label>
                            <input asp-for="NombreUsuario"
                                   type="text"
                                   class="form-control-custom"
                                   placeholder="Ej. admin.discoteca"
                                   maxlength="50"
                                   autocomplete="username" />
                        </div>

                        <div class="form-group-custom">
                            <label asp-for="Contrasena" class="form-label-custom">Contraseña</label>
                            <input asp-for="Contrasena"
                                   type="password"
                                   class="form-control-custom"
                                   placeholder="••••••••••••"
                                   maxlength="255"
                                   autocomplete="current-password" />
                        </div>

                        <div class="button-group">
                            <button type="submit" asp-page-handler="BtEnter" class="btn-gold">
                                <span>Ingresar al sistema</span>
                                <span>→</span>
                            </button>

                            <button type="submit" asp-page-handler="BtClean" class="btn-outline-custom">
                                Limpiar campos
                            </button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="logged-box">
                        <h1>Sesión <span>Activa.</span></h1>
                        <p class="login-subtitle">Has iniciado sesión correctamente como:</p>

                        <div class="logged-user">
                            @HttpContext.Session.GetString("Usuario")
                        </div>

                        <form method="post" class="button-group">
                            @Html.AntiForgeryToken()

                            <a href="/Consultar" class="btn-gold" style="text-decoration: none;">
                                Ir al Inventario →
                            </a>

                            <button type="submit" asp-page-handler="BtClose" class="btn-danger-custom">
                                Cerrar sesión
                            </button>
                        </form>
                    </div>
                }

            </div>
        </main>

        <!-- PIE DE PÁGINA -->
        <footer class="page-footer">
            <span>© 2026 Discoteca X</span>
            <span>SISTEMA DE GESTIÓN E INVENTARIO</span>
        </footer>

    </div>

</body>
</html>