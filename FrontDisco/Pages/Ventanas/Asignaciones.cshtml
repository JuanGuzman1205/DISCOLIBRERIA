@page
@model AsignacionesModel
@{
    ViewData["Title"] = "Asignaciones";
}

<div class="text-center">
    <h1 class="display-4">Asignaciones</h1>

    <table>
        <tr>
            <th>Codigo</th>
            <th>Nombre</th>
            <th>Lugar</th>
            <th>Inicio</th>
            <th>Final</th>
            <th>Notas</th>
        </tr>
        @if (Model != null && Model.Lista != null)
        {
            foreach (var elemento in Model.Lista)
            {
                <tr>
                    <td>@elemento.Codigo</td>
                    <td>@elemento.Nombre</td>
                    <td>@elemento.Lugar</td>
                    <td>@elemento.Inicio</td>
                    <td>@elemento.Final</td>
                    <td>@elemento.Notas</td>
                </tr>
            }
        }
    </table>
</div>
